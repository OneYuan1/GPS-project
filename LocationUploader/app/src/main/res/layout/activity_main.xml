<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="LocationUploader"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/getLocationButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="获取位置"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/startUploadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开始上传"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/stopUploadButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止上传"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/networkConfigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="本地网络配置"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/remoteConfigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="远程网络配置"
        android:layout_marginBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/locationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="点击获取位置按钮开始..."
                android:textSize="14sp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/gnssStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GNSS状态: 未启动"
                android:textSize="12sp"
                android:background="#F0F0F0"
                android:padding="8dp"
                android:textColor="#333333" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>